{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A node_modules/concurrently/dist/bin/index.js -n api,vite -c blue,magenta \"deno task dev:api\" \"deno task dev:vite\"",
    "dev:api": "deno run -A --watch=src/server.ts,src/routes/ src/server.ts",
    "dev:vite": "deno run -A node_modules/vite/bin/vite.js",
    "build": "deno run -A node_modules/vite/bin/vite.js build",
    "check": "deno check src/server.ts src/ui/main.tsx vite.config.ts",
    "verify": "deno fmt --check && deno lint && deno task check && deno task build",
    "generate": "deno run --allow-read --allow-write src/generate.ts",
    "generate:en": "deno run --allow-read --allow-write src/generate.ts --lang en",
    "convert": "deno run -A src/convert.ts",
    "convert:en": "deno run -A src/convert.ts --lang en",
    "build:en": "deno task generate:en && deno task convert:en"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.ns", "dom", "dom.iterable"]
  },
  "lint": {
    "exclude": ["dist/", "node_modules/"]
  },
  "fmt": {
    "exclude": ["dist/", "node_modules/", "**/*.md", ".github/**/*.md"]
  },
  "exclude": ["dist/", "node_modules/"],
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@/": "./src/",
    "@app-types": "./src/types/index.ts",
    "@app-types/": "./src/types/",
    "@routes": "./src/routes/index.ts",
    "@routes/": "./src/routes/",
    "@ui/": "./src/ui/",
    "@lib": "./src/lib/index.ts",
    "@lib/": "./src/lib/",
    "@device-presets": "./src/device-presets/index.ts",
    "@device-presets/": "./src/device-presets/",
    "@renderer": "./src/renderer-components/index.ts",
    "@renderer/": "./src/renderer-components/",
    "@hooks": "./src/ui/hooks/index.ts",
    "@hooks/": "./src/ui/hooks/"
  }
}
